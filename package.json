{
	"name": "sveltekit-bunny",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "node --env-file=.env ./node_modules/sveltekit-adapter-bunny/src/cli.js",
		"upload-assets": "node --env-file=.env ./scripts/upload-assets.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"sveltekit-adapter-bunny": "git+https://github.com/planza-digital/sveltekit-adapter-bunny.git",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
